# =============================================================================
# MomaCodeBase 环境配置模板
# =============================================================================
# 复制此文件为 env 并根据实际环境修改配置

# =============================================================================
# 基础配置
# =============================================================================
DEBUG=false
APP_LOG_LEVEL=INFO

# =============================================================================
# 运行时数据目录（SQLite、模型配置等）
# =============================================================================
RUNTIME_DATA_DIR=./data

# =============================================================================
# 数据库
# =============================================================================
DB_NAME=code_analysis_service
DATABASE_TYPE=sqlite
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PostgreSQL（DATABASE_TYPE=postgresql 时使用）
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=your_password

# MySQL（DATABASE_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# =============================================================================
# 向量存储
# =============================================================================
# 引擎: lancedb（默认，本地目录）| elasticsearch | opensearch
VECTOR_STORE_ENGINE=lancedb
LANCEDB_URI=
VECTOR_STORE_MAPPING=es_doc_mapping.json

ES_HOSTS=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_VERIFY_CERTS=false

OS_HOSTS=http://localhost:9200
OS_USERNAME=admin
OS_PASSWORD=admin

# =============================================================================
# 四类能力开关（分析入库 + 对应检索接口同源；默认全开）
# =============================================================================
# Symbol：符号摘要向量 + search related
CODE_ANALYSIS_SYMBOL_SUMMARY_ENABLED=true
# Line chunk：行块向量 + search similar
CODE_ANALYSIS_LINE_CHUNK_ENABLED=true
# CodeGraph：依赖图谱 + search related / dependents 等
CODE_GRAPH_ENABLED=true
# MR 经验：experience analyze + search pattern
MR_EXPERIENCE_ENABLED=true
MR_EXPERIENCE_MIN_QUALITY_SCORE=0.55
MR_EXPERIENCE_MERGE_BY_SCENARIO=true

# =============================================================================
# 图数据库 / CodeGraph（实现细节）
# =============================================================================
# 实现选择：codegraph（开源 CLI，默认）| builtin（自研 Neo4j）
CODE_GRAPH_PROVIDER=codegraph
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jneo4j
NEO4J_POOL_SIZE=5
NEO4J_MAX_OVERFLOW=10

# =============================================================================
# 模型配置（chat/embedding 清单见 {RUNTIME_DATA_DIR}/models/*.json）
# =============================================================================
MODEL_CACHE_DIR=model_cache_dir
MODEL_TEMP_DIR=model_temp_dir

# =============================================================================
# 代码仓管理
# =============================================================================
REPO_STORAGE_PATH=./data/repos

# =============================================================================
# 增量扫描
# =============================================================================
# 程序运行后是否自动扫描已登记仓库变更（code/lib 文件 + code 仓新 MR 经验，默认 300 秒一轮）
ENABLE_INCREMENTAL_SCAN=true
INCREMENTAL_SCAN_INTERVAL_SEC=300

# =============================================================================
# 代码仓分析（切片参数 / 并发）
# =============================================================================
LSP_ENABLED=true
CODE_ANALYSIS_LINE_CHUNK_TARGET_LINES=5
CODE_ANALYSIS_LINE_CHUNK_OVERLAP_LINES=1
CODE_ANALYSIS_LINE_CHUNK_MAX_LINES=200
CODE_ANALYSIS_SYMBOL_SUMMARY_LLM_CONCURRENCY=4
CODE_ANALYSIS_FILE_WORKER_COUNT=10
