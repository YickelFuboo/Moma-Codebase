# =============================================================================
# Knowledge-Service 环境配置模板
# =============================================================================
# 复制此文件为 .env 并根据实际环境修改配置

# =============================================================================
# 基础配置
# =============================================================================
SERVICE_HOST=127.0.0.1
SERVICE_PORT=9001

DEBUG=true
APP_LOG_LEVEL=WARNING

# =============================================================================
# 认证配置 (User-Service集成)
# =============================================================================
# User-Service地址 - 用于JWT验证
AUTH_USER_SERVICE_URL=http://user-service:8001

# 请求超时配置（秒）
AUTH_REQUEST_TIMEOUT=5

# JWT相关端点配置
AUTH_JWKS_ENDPOINT=/.well-known/jwks.json
AUTH_JWT_CONFIG_ENDPOINT=/jwt-config
AUTH_BLACKLIST_ENDPOINT=/blacklist

# =============================================================================
# 基础设施配置
# =============================================================================
# ========================数据库配置========================
# 数据库名称
DB_NAME=pando_aiworker_service
# 数据库类型: postgresql/mysql/sqlite
DATABASE_TYPE=sqlite
# SQLite 配置 (如果使用SQLite)
SQLITE_PATH=./data/sqlite/pando_aiworker_service.db
# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# PostgreSQL 配置
POSTGRESQL_HOST=localhost
POSTGRESQL_PORT=5432
POSTGRESQL_USER=postgres
POSTGRESQL_PASSWORD=clover

# MySQL 配置 (如果使用MySQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password

# ========================Redis 配置========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_DECODE_RESPONSES=true
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_SOCKET_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_MAX_CONNECTIONS=10

# ========================文件存储配置========================
# 存储类型: minio, s3, local, azure_sas
STORAGE_TYPE=local

# MinIO 配置 (推荐用于开发环境)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# S3 配置
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://your-s3-endpoint.com  # 必需，指定S3兼容服务的端点
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_USE_SSL=false

# 本地存储配置 (简单文件存储，不指定则使用默认目录data/upload_files)
LOCAL_UPLOAD_DIR=./data/upload_files

# Azure Blob Storage SAS配置
AZURE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
AZURE_SAS_TOKEN=your_sas_token

# Azure Blob Storage SPN配置
AZURE_SPN_ACCOUNT_URL=https://yourstorageaccount.dfs.core.windows.net
AZURE_SPN_CLIENT_ID=your_client_id
AZURE_SPN_CLIENT_SECRET=your_client_secret
AZURE_SPN_TENANT_ID=your_tenant_id
AZURE_SPN_CONTAINER_NAME=your_container

# 阿里云OSS配置
OSS_ACCESS_KEY=your_access_key
OSS_SECRET_KEY=your_secret_key
OSS_ENDPOINT_URL=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_PREFIX_PATH=


# ========================向量存储配置 - Vector Store=========
# 向量存储引擎类型 (elasticsearch, opensearch, infinity)
VECTOR_STORE_ENGINE=elasticsearch
# 向量存储映射文件名称
VECTOR_STORE_MAPPING=es_doc_mapping.json

# Elasticsearch配置
ES_HOSTS=https://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=clover
# 是否校验 ES 服务端 TLS 证书，本地自签证书可设为 false
ES_VERIFY_CERTS=false

# OpenSearch配置
OS_HOSTS=http://localhost:9200
OS_USERNAME=admin
OS_PASSWORD=admin

# ========================图数据库配置=========
NEO4J_URI = "neo4j://localhost:7687"
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = "neo4jneo4j"  # 需要修改
NEO4J_POOL_SIZE = 5
NEO4J_MAX_OVERFLOW = 10

# ========================模型配置说明 见：app/config/xxx.json========================

# =============================================================================
# Web 工具配置 - Web Search / Fetch
# =============================================================================
# Tavily（搜索 + 正文抽取，https://tavily.com）
TAVILY_API_KEY=
# Brave 搜索（https://api.search.brave.com）
BRAVE_API_KEY=
# Serper 搜索（https://serper.dev，Google SERP，2500 次免费）
SERPER_API_KEY=
# Firecrawl 抓取（https://firecrawl.dev）
FIRECRAWL_API_KEY=
# Jina Reader 抓取（https://jina.ai/reader，Key 可选，无 Key 匿名限流）
JINA_API_KEY=
# web_search 主选 + 备选（备选留空=不回退；可选 tavily | brave | serper | duckduckgo）
WEB_SEARCH_PRIMARY=serper
WEB_SEARCH_FALLBACK=duckduckgo
# web_fetch 主选 + 备选（备选留空=不回退；可选 static | jina | tavily | firecrawl）
WEB_FETCH_PRIMARY=static
WEB_FETCH_FALLBACK=jina

# ========================市场数据服务 / Market Data========================
# auto=Wind(已登录) > Choice(已配置) > Tushare(有Token) > AKShare；也可强制 wind/choice/tushare/akshare
MARKET_DATA_PROVIDER=auto
# Tushare Pro Token（https://tushare.pro）；pip install tushare
TUSHARE_TOKEN=
# Wind 终端：需本机安装 Wind 客户端 + WindPy 并已登录；无终端时设 false 跳过探测
WIND_ENABLED=true
# 东方财富 Choice：需机构账号 + EmQuantAPI；留空则跳过
CHOICE_USERNAME=
CHOICE_PASSWORD=
CHOICE_ACTIVATE_CODE=

# ========================Skills Hub / GitHub========================
# skills.sh、GitHub 来源安装需拉取仓库文件；未配置时匿名请求易触发 GitHub API 限流（403）
# 配置写入项目根目录 env 文件（非 .env）；GitHub Settings → Developer settings → Personal access tokens
GITHUB_TOKEN=
# 或使用 GH_TOKEN（与 GITHUB_TOKEN 二选一即可）
# GH_TOKEN=

# ========================Agent配置========================
# 会话存储方式：true=本地文件，false=数据库
AGENT_SESSION_USE_LOCAL_STORAGE=true
# 同会话新消息是否中断当前 Agent（true=中断并优先新消息，false=排队）
ENABLE_MESSAGE_INTERRUPT=true
# /stop 软中止后等待协作退出的宽限(秒)，超时则 cancel run；/kill 立即强杀
AGENT_RUN_HARD_KILL_GRACE_SEC=15

# 工具结果超长保存到文件（true/false）
ENABLE_TOOL_RESULT_TRUNCATE=false
# 工具结果截断阈值（超限时落盘 workspace/tool_output，仅摘要进上下文）
TOOL_RESULT_TRUNCATE_MAX_LINES=2000
TOOL_RESULT_TRUNCATE_MAX_BYTES=51200

# ========================会话上下文控制========================
# 1) 消息压缩（compact）
# 触发公式：overflow_basis >= CONTEXT_LIMIT - max_output_tokens - RESERVED
# overflow_basis：优先 input_tokens+cache_read_tokens+cache_write_tokens，否则 total_tokens
# 是否自动摘要压缩会话历史（true/false）
COMPACTION_AUTO=true
# 压缩后保留的最近消息条数
COMPACTION_KEEP_LAST_N=10
# 触发压缩时预留的 token 缓冲（越大越早触发）
COMPACTION_RESERVED=8000
# 用于判断溢出的上下文上限（token）
COMPACTION_CONTEXT_LIMIT=64000

# 2) 历史工具结果清空（prune）
# 对未压缩的消息中的工具执行类结果进行清空
# 触发条件：未压缩的消息中的工具执行类结果的token数 >= COMPACTION_PRUNE_MINIMUM。最近的tool结果内容不清空（通过COMPACTION_PRUNE_PROTECT保护）
# 不参与清空的工具名（逗号分隔）：COMPACTION_PRUNE_PROTECTED_TOOLS
# 是否启用旧 tool result 正文清空（true/false）
COMPACTION_PRUNE=true
# 保护窗口（token）：最新的PROTECT个Token对应的Tool结果不清空
COMPACTION_PRUNE_PROTECT=12000
# 最小清空门槛（token），出去保护部分，更早的工具结果需要超过本参数才进行
COMPACTION_PRUNE_MINIMUM=4000
# 不参与清空的工具名（逗号分隔）
COMPACTION_PRUNE_PROTECTED_TOOLS=skill
